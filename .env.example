# ==============================================================================
# FormAssist Client Environment Variables (.env.example)
# Public values only — NEVER place private keys or secrets here!
# Copy to .env.local for local development.
# ==============================================================================

# VITE_API_MODE: 'mock' (default for isolated preview) or 'live' (calls deployed Supabase Edge Functions)
VITE_API_MODE="mock"

# Public Supabase Connection (Client-facing anon credentials):
# Safe to expose to the browser; secured by Row Level Security (RLS) on Postgres.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# ------------------------------------------------------------------------------
# SECURITY NOTICE (NFR-SEC.3):
# Private secrets (GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY) MUST NEVER be placed
# in this file or any client bundle. They are configured strictly via:
# `supabase secrets set GEMINI_API_KEY=...` or in the Supabase Dashboard.
# ------------------------------------------------------------------------------
